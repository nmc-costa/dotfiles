[Unit]
Description=DTx providers local LiteLLM proxy (bridges custom openai-compat models to the wire formats Claude Code / Codex CLI expect)
After=network-online.target

[Service]
EnvironmentFile=%h/.custom_providers/proxy.env
ExecStart=/usr/bin/env litellm --config %h/.custom_providers/litellm-config.yaml --port 4444 --host 127.0.0.1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
