# Local environment
.DS_Store
.swp
.swo
*~
*.swp
*.bak

# IDE
.vscode/*
# settings.json contains a real API key and is managed by chezmoi+age
# (see SECRETS.md) — it must never be committed as plaintext again.
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.sublime-*

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Logs and runtime
*.log
.env
.env.local
*.pid

# OS
Thumbs.db
node_modules/

# Temporary
temp/
tmp/
*.tmp
.cache/

# Agent-specific (don't track user sessions/logs)
.claude/sessions/
.claude/logs/
.claude/cache/
# Defense-in-depth: ~/.claude/ is only ever file-symlinked (CLAUDE.md), never
# whole-directory (see setup.sh), so none of this should ever land under
# dotfiles/.claude/ — these entries just make sure a future mistake can't
# commit live runtime state, credentials included.
.claude/.credentials.json
.claude/history.jsonl
.claude/daemon.log
.claude/daemon.lock
.claude/daemon.status.json
.claude/.last-cleanup
.claude/shell-snapshots/
.claude/session-env/
.claude/file-history/
.claude/jobs/
.claude/backups/
.claude/projects/
.agents/cache/
.copilot/sessions/
.cline/sessions/

# But DO track core configs
!.claude/
!.agents/
!.vscode/
!.github/
