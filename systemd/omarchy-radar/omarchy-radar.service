[Unit]
Description=omarchy-radar daily digest (Omarchy Linux Quattro community) -- proposes changes on a disposable git-worktree branch, never applies them
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
ExecStart=%h/dotfiles/.agents/skills/omarchy-radar/scripts/run.sh
TimeoutStartSec=600
Environment=PATH=%h/.local/bin:/usr/bin:/bin

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=%h/dotfiles %h/.local/state/omarchy-radar %h/.claude
